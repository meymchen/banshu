# Export the API keys you want the live smoke test to use. The script does not
# load this file automatically; keep real values in an ignored .env file or in
# your shell environment.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=

# Optional bundled-catalog model overrides.
BANSHU_AI_DEEPSEEK_MODEL=deepseek-v4-flash
BANSHU_AI_KIMI_MODEL=k3-256k
BANSHU_AI_MINIMAX_MODEL=MiniMax-M3
