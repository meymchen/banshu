root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

# Two trailing spaces are meaningful hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
